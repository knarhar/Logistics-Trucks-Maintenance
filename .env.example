# ======================================
# 🚚 Logistics Trucks Maintenance API
# ======================================

# --- Project Info ---
PROJECT_NAME=Logistics Trucks Maintenance API
VERSION=1.0.0
API_V1_STR=/api/v1

# --- Database Configuration ---
# Example: postgresql+asyncpg://user:password@localhost:5432/logistics_db
DATABASE_URL=

# --- Security Settings ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60  # 1 hour
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudinary Configuration ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=logistics_incidents

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- File Upload Settings ---
MAX_UPLOAD_SIZE=5242880  # 5MB
# Allowed image MIME types are defined in code
